# Copy this file to .env and fill in your real values.
# Get these from your Supabase project: Settings -> API

SUPABASE_URL=https://qatcvwvopaqhtzlmpotr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=random_key


# Name of the Supabase Storage bucket you create for uploaded question papers
SUPABASE_STORAGE_BUCKET=question-papers

# Upload validation limits
MAX_FILE_SIZE_MB=15
MAX_PDF_PAGES=20

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
